Bootstrap: docker
From: python:3.11-slim

%arguments
    VERSION=0+container

# Build from a checkout of this repository:
#
#     apptainer build /tmp/s1-geometry.sif apptainer.def
#
# then run it like the console script:
#
#     apptainer run /tmp/s1-geometry.sif --help

%files
    pyproject.toml /opt/s1-geometry/pyproject.toml
    README.md /opt/s1-geometry/README.md
    LICENSE /opt/s1-geometry/LICENSE
    src /opt/s1-geometry/src

%post
    # no .git in the image: give hatch-vcs the version explicitly, e.g.
    #     apptainer build --build-arg VERSION=2026.11.20 s1-geometry.sif apptainer.def
    export SETUPTOOLS_SCM_PRETEND_VERSION={{ VERSION }}
    python -m pip install --no-cache-dir /opt/s1-geometry

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec s1-geometry "$@"

%labels
    org.soba.tool s1-geometry
    org.soba.description Geometric quantities from a Sentinel-1 SAR footprint

%help
    Estimate Sentinel-1 geometric quantities from the footprint metadata,
    e.g. the ground heading of an IW acquisition from its SAFE footprint:

        apptainer run --bind /path/to/footprints:/footprints s1-geometry.sif \
            heading /footprints/footprint.geojson --lat 36.59
